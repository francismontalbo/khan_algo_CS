{
  "indegree(v) = |{u : (u,v) ∈ E}|": "\\operatorname{indegree}(v)=\\left|\\left\\{u:(u,v)\\in E\\right\\}\\right|",
  "d_D(v) = |pred(v) ∖ D|;  choose only v with d_D(v) = 0.": "\\begin{gathered}d_D(v)=\\left|\\operatorname{pred}(v)\\setminus D\\right|\\\\\\text{choose only }v\\text{ with }d_D(v)=0\\end{gathered}",
  "For every edge u → v in a DAG, finish(v) < finish(u).": "\\begin{gathered}\\text{For every edge }u\\to v\\text{ in a DAG,}\\\\\\operatorname{finish}(v)<\\operatorname{finish}(u)\\end{gathered}",
  "v* = argmax { (score(v), −id(v)) : v ∈ R(D) }": "v^{*}=\\underset{v\\in R(D)}{\\operatorname{arg\\,max}}\\,\\bigl(\\operatorname{score}(v),-\\operatorname{id}(v)\\bigr)",
  "Remove (u,v) only if u reaches v in G without that edge.": "\\begin{gathered}\\text{Remove }(u,v)\\text{ only if}\\\\u\\rightsquigarrow v\\quad\\text{in }G\\setminus\\{(u,v)\\}\\end{gathered}",
  "finish(v) = duration(v) + max({finish(u) : u ∈ pred(v)} ∪ {0})": "\\begin{aligned}\\operatorname{finish}(v)&=\\operatorname{duration}(v)\\\\&\\quad+\\max\\!\\left(\\{0\\}\\cup\\left\\{\\operatorname{finish}(u)\\right\\}_{u\\in\\operatorname{pred}(v)}\\right)\\end{aligned}",
  "score_D(v) = −created(v) + Σ_f bytes(f) · 1[v ∈ C_f and |C_f ∖ D| = 1]": "\\begin{aligned}\\operatorname{score}_D(v)&=-\\operatorname{created}(v)\\\\&\\quad+\\sum_{\\substack{f:\\ v\\in C_f\\\\\\lvert C_f\\setminus D\\rvert=1}}\\operatorname{bytes}(f)\\end{aligned}",
  "A new u → v creates a cycle iff u = v or v already reaches u.": "\\begin{gathered}\\text{A new }u\\to v\\text{ creates a cycle}\\\\\\Longleftrightarrow\\quad u=v\\;\\lor\\;\\bigl(v\\rightsquigarrow u\\text{ before insertion}\\bigr)\\end{gathered}",
  "Same prefix + same ready priorities + same tie-break ⇒ same next task.": "\\begin{gathered}\\text{same prefix}\\;\\land\\;\\text{same ready priorities}\\\\\\land\\;\\text{same tie-break}\\\\\\Longrightarrow\\quad\\text{same next task}\\end{gathered}",
  "T_preparation + T_modified ordering < T_reference ordering": "T_{\\text{preparation}}+T_{\\text{modified ordering}}<T_{\\text{reference ordering}}",
  "d(v) = # unfinished predecessors; choose only d(v) = 0": "\\begin{gathered}d(v)=\\#\\{\\text{unfinished predecessors of }v\\}\\\\\\text{choose only }v\\text{ with }d(v)=0\\end{gathered}",
  "u = most recently added ready task": "u=\\text{most recently added ready task}",
  "u = arg max ready priority(v); smallest task ID breaks ties": "\\begin{gathered}u=\\underset{v\\text{ ready}}{\\operatorname{arg\\,max}}\\,\\operatorname{priority}(v)\\\\\\text{smallest task ID breaks ties}\\end{gathered}",
  "u = smallest task ID in the ready set": "u=\\min\\{v:v\\text{ is ready}\\}",
  "g(v) = 0 for sources; otherwise 1 + max predecessor g(u)": "g(v)=\\begin{cases}0,&\\operatorname{pred}(v)=\\varnothing,\\\\1+\\displaystyle\\max_{u\\in\\operatorname{pred}(v)}g(u),&\\text{otherwise.}\\end{cases}",
  "order = reverse(finish list)": "\\operatorname{order}=\\operatorname{reverse}(\\text{finish list})",
  "distance(v) = distance(parent(v)) + 1": "\\operatorname{distance}(v)=\\operatorname{distance}\\bigl(\\operatorname{parent}(v)\\bigr)+1",
  "examined edges ≤ B; exhausted budget ⇒ UNKNOWN": "\\begin{gathered}\\text{examined edges}\\le B\\\\\\text{exhausted budget}\\;\\Longrightarrow\\;\\text{UNKNOWN}\\end{gathered}",
  "remove u → v iff v remains reachable from u without that edge": "\\begin{gathered}\\text{remove }u\\to v\\\\\\Longleftrightarrow\\quad u\\rightsquigarrow v\\;\\text{in }G\\setminus\\{(u,v)\\}\\end{gathered}",
  "orders(G) = every permutation satisfying position(u) < position(v)": "\\operatorname{orders}(G)=\\left\\{\\pi\\in\\operatorname{Perm}(V):\\operatorname{position}_{\\pi}(u)<\\operatorname{position}_{\\pi}(v)\\;\\text{for all }(u,v)\\in E\\right\\}",
  "EF(v) ← max(EF(v), EF(u) + duration(v))": "\\operatorname{EF}(v)\\leftarrow\\max\\!\\left(\\operatorname{EF}(v),\\operatorname{EF}(u)+\\operatorname{duration}(v)\\right)",
  "position(u) < position(v) ⇒ retain order; v ⇝ u ⇒ reject u → v": "\\begin{gathered}\\operatorname{position}(u)<\\operatorname{position}(v)\\;\\Longrightarrow\\;\\text{retain order}\\\\v\\rightsquigarrow u\\;\\Longrightarrow\\;\\text{reject }u\\to v\\end{gathered}",
  "affected positions ← B in old order, followed by F in old order": "\\begin{gathered}\\text{affected positions}\\leftarrow\\bigl(B\\text{ in old order}\\bigr)\\\\\\text{followed by }\\bigl(F\\text{ in old order}\\bigr)\\end{gathered}",
  "low(u) = smallest active index reachable under the DFS low-link rules": "\\begin{gathered}\\operatorname{low}(u)=\\text{smallest active index reachable}\\\\\\text{under the DFS low-link rules}\\end{gathered}",
  "valid entry ⇔ stored version = current task version": "\\text{valid entry}\\;\\Longleftrightarrow\\;\\text{stored version}=\\text{current task version}",
  "s(v) = −created(v) + Σ size(f) · [v is the final unfinished consumer]": "\\begin{aligned}s(v)&=-\\operatorname{created}(v)\\\\&\\quad+\\sum_{\\substack{f:\\ v\\text{ is the final}\\\\\\text{unfinished consumer of }f}}\\operatorname{size}(f)\\end{aligned}",
  "peak = maxₜ Σ size(f) for generated files live at t": "\\operatorname{peak}=\\max_t\\sum_{\\substack{f\\text{ generated}\\\\f\\text{ live at }t}}\\operatorname{size}(f)",
  "rank(u) = avg cost(u) + maxᵥ[comm + rank(v)]; choose min EFT(u,p)": "\\begin{gathered}\\operatorname{rank}(u)=\\overline{\\operatorname{cost}}(u)+\\max_v\\bigl[\\operatorname{comm}+\\operatorname{rank}(v)\\bigr]\\\\\\text{choose }\\displaystyle\\min_p\\operatorname{EFT}(u,p)\\end{gathered}",
  "sort: O(k log k); scan: O(L) membership inspections": "\\begin{gathered}\\text{sort: }O(k\\log k)\\\\\\text{scan: }O(L)\\;\\text{membership inspections}\\end{gathered}",
  "victim = arg min reference count among resident items": "\\operatorname{victim}=\\underset{f\\text{ resident}}{\\operatorname{arg\\,min}}\\,\\operatorname{reference\\,count}(f)",
  "R = {v : d(v) = 0}": "R=\\{v:d(v)=0\\}",
  "|output| < |V|": "\\lvert\\operatorname{output}\\rvert<\\lvert V\\rvert",
  "∀(u,v) ∈ E, position(u) < position(v)": "\\forall\\,(u,v)\\in E,\\quad\\operatorname{position}(u)<\\operatorname{position}(v)",
  "L₀ = {v : d(v) = 0}": "L_0=\\{v:d(v)=0\\}",
  "color ∈ {unseen, active, finished}": "\\operatorname{color}\\in\\{\\text{unseen},\\text{active},\\text{finished}\\}",
  "edge to active vertex ⇒ directed cycle": "\\text{edge to active vertex}\\;\\Longrightarrow\\;\\text{directed cycle}",
  "order = reverse(finish)": "\\operatorname{order}=\\operatorname{reverse}(\\operatorname{finish})",
  "budget exhausted ≠ unreachable": "\\text{budget exhausted}\\;\\ne\\;\\text{unreachable}",
  "empty frontier + completed search ⇒ no path": "\\begin{gathered}\\text{empty frontier}\\;\\land\\;\\text{completed search}\\\\\\Longrightarrow\\quad\\text{no path}\\end{gathered}",
  "remove (u,v) only if u reaches v without that edge": "\\begin{gathered}\\text{remove }(u,v)\\text{ only if}\\\\u\\rightsquigarrow v\\quad\\text{in }G\\setminus\\{(u,v)\\}\\end{gathered}",
  "no alternate path": "\\text{no alternate path}",
  "reachability(G) = reachability(reduced G)": "\\operatorname{reachability}(G)=\\operatorname{reachability}(G_{\\text{reduced}})",
  "eligible(v) ⇔ every predecessor is used": "\\operatorname{eligible}(v)\\;\\Longleftrightarrow\\;\\operatorname{pred}(v)\\subseteq\\operatorname{used}",
  "backtrack: restore the previous prefix": "\\text{backtrack: restore the previous prefix}",
  "EF(v) = duration(v) initially": "\\operatorname{EF}(v)=\\operatorname{duration}(v)\\quad\\text{initially}",
  "position(u) < position(v) ⇒ no repair": "\\operatorname{position}(u)<\\operatorname{position}(v)\\;\\Longrightarrow\\;\\text{no repair}",
  "v reaches u + (u → v) ⇒ cycle": "\\bigl(v\\rightsquigarrow u\\bigr)\\;\\land\\;(u\\to v)\\;\\Longrightarrow\\;\\text{cycle}",
  "new affected order = B (old order) followed by F (old order)": "\\begin{gathered}\\text{new affected order}=B\\text{ (old order)}\\\\\\text{followed by }F\\text{ (old order)}\\end{gathered}",
  "new order = Kahn(G + edge)": "\\text{new order}=\\operatorname{Kahn}\\bigl(G+\\text{edge}\\bigr)",
  "∀(a,b), position(a) < position(b)": "\\forall\\,(a,b),\\quad\\operatorname{position}(a)<\\operatorname{position}(b)",
  "u and v share a component iff u ⇝ v and v ⇝ u": "\\begin{gathered}u\\text{ and }v\\text{ share a component}\\\\\\Longleftrightarrow\\quad\\bigl(u\\rightsquigarrow v\\bigr)\\land\\bigl(v\\rightsquigarrow u\\bigr)\\end{gathered}",
  "entry valid ⇔ version(entry) = version(task)": "\\text{entry valid}\\;\\Longleftrightarrow\\;\\operatorname{version}(\\text{entry})=\\operatorname{version}(\\text{task})",
  "stale version ⇒ ignore": "\\text{stale version}\\;\\Longrightarrow\\;\\text{ignore}",
  "s(v) = releasable bytes − bytes created by v": "\\begin{aligned}s(v)&=\\text{releasable bytes}\\\\&\\quad-\\text{bytes created by }v\\end{aligned}",
  "credit f iff |C(f) − done| = 1": "\\text{credit }f\\;\\Longleftrightarrow\\;\\bigl\\lvert C(f)\\setminus\\operatorname{done}\\bigr\\rvert=1",
  "r ← r − 1": "r\\leftarrow r-1",
  "eligible(v) ⇔ d(v) = 0": "\\operatorname{eligible}(v)\\;\\Longleftrightarrow\\;d(v)=0",
  "same ready scores + same tie-break ⇒ same order": "\\begin{gathered}\\text{same ready scores}\\;\\land\\;\\text{same tie-break}\\\\\\Longrightarrow\\quad\\text{same order}\\end{gathered}",
  "stored bytes = sum of live generated-file sizes": "\\text{stored bytes}=\\sum_{\\substack{f\\text{ generated}\\\\f\\text{ live}}}\\operatorname{size}(f)",
  "peak ← max(peak, current retained bytes)": "\\operatorname{peak}\\leftarrow\\max\\bigl(\\operatorname{peak},\\text{current retained bytes}\\bigr)",
  "delete intermediate f iff remaining consumers = 0": "\\begin{gathered}\\text{delete intermediate }f\\\\\\Longleftrightarrow\\quad\\text{remaining consumers}=0\\end{gathered}",
  "rank(u) = average cost(u) + maxᵥ [communication + rank(v)]": "\\begin{aligned}\\operatorname{rank}(u)&=\\overline{\\operatorname{cost}}(u)\\\\&\\quad+\\max_v\\bigl[\\operatorname{communication}+\\operatorname{rank}(v)\\bigr]\\end{aligned}",
  "EFT(u,p) = first feasible start + execution cost": "\\begin{aligned}\\operatorname{EFT}(u,p)&=\\text{first feasible start}\\\\&\\quad+\\text{execution cost}\\end{aligned}",
  "choose processor with minimum EFT": "\\text{choose processor with minimum }\\operatorname{EFT}",
  "comparison-sort bound O(k log k); not a measured time": "\\begin{gathered}\\text{comparison-sort bound }O(k\\log k)\\\\\\text{not a measured time}\\end{gathered}",
  "L positions inspected; constant-time membership assumed": "\\begin{gathered}L\\text{ positions inspected}\\\\\\text{constant-time membership assumed}\\end{gathered}",
  "sort result = scan result": "\\text{sort result}=\\text{scan result}",
  "victim = argmin resident reference count": "\\operatorname{victim}=\\underset{f\\text{ resident}}{\\operatorname{arg\\,min}}\\,\\operatorname{reference\\,count}(f)"
}
